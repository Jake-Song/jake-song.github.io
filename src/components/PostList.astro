---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, tagUrl } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post, index) => <article class="post-row">
    <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="post-content"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="meta-dot">·</span><span>NOTE</span></div><h3><a href={postUrl(post.id)}>{post.data.title}<span class="post-arrow" aria-hidden="true">↗</span></a></h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div></div>
  </article>)}
  {posts.length === 0 && <p class="empty-state">아직 공개된 글이 없습니다. 첫 번째 기록을 준비하고 있어요.</p>}
</div>
